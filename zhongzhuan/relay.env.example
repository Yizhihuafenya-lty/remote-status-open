# Copy to /etc/remote-status/relay.env and chmod 600.
RELAY_LISTEN=:50001
RELAY_TLS_CERT_FILE=/etc/remote-status/tls/fullchain.pem
RELAY_TLS_KEY_FILE=/etc/remote-status/tls/privkey.pem
RELAY_DATA_TTL=90s
RELAY_STATE_FILE=/var/lib/remote-status/state.json

# Shared by all Linux agents in this deployment. New devices need no relay edit.
RELAY_FLEET_KEY=replace-with-a-long-random-fleet-key

# The App token is compiled into each APK build; keep this file mode 600.
RELAY_APP_TOKENS=replace-with-app-token
