# Copy to /etc/remote-status/agent.env and chmod 600.
# Replace the placeholders before starting the service.
AGENT_RELAY_URL=https://relay.example.com:50001
# Use the same deployment file on every server. Device ID is derived from /etc/machine-id.
AGENT_FLEET_KEY=replace-with-a-long-random-fleet-key
AGENT_INTERVAL=1s
# Only for a temporary local HTTP smoke test. Keep false/unset in production.
AGENT_ALLOW_INSECURE=false
